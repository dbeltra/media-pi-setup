NORDVPN_PRIVATE_KEY=YOUR_KEY_HERE

# Cloudflare + Caddy reverse proxy
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
DOMAIN=example.com
ACME_EMAIL=you@example.com

# Pi-hole admin / API password
PIHOLE_PASSWORD=CHANGE_ME

# Dashboard (consumed by generate-config.sh to build www/config.json).
# Service API keys: Sonarr/Radarr/Prowlarr/Bazarr → each service's Settings → General.
# JELLYFIN_API_KEY: Jellyfin → Dashboard → API Keys (any key with admin rights).
# QBITTORRENT_PASSWORD: the qBittorrent Web UI password.
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
JELLYFIN_API_KEY=
BAZARR_API_KEY=
QBITTORRENT_PASSWORD=

# Health monitoring (healthcheck.py). Invent a long random topic — anyone who
# knows it can read your alerts and post to it, so treat it like a password.
# Install the ntfy app and subscribe to the same topic to receive alerts.
NTFY_TOPIC=media-pi-CHANGE_ME_TO_SOMETHING_RANDOM

# Dead-man's switch (optional but recommended). healthcheck.py runs ON the
# server, so if the box dies it sends nothing and silence looks like health.
# Create a free check at https://healthchecks.io, paste its ping URL here, and
# it will alert you when the pings stop. Leave empty to disable.
HEALTHCHECK_PING_URL=
